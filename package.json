{
  "name": "findy-hackathon-app",
  "type": "module",
  "scripts": {
    "setup:skills": "node scripts/setup-skills.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "$npm_execpath run build && vite preview",
    "deploy": "$npm_execpath run build && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "dependencies": {
    "agents": "^0.20.1",
    "hono": "^4.12.27",
    "hono-agents": "^3.0.11",
    "mapbox-gl": "^3.27.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.42.2",
    "@cloudflare/vitest-pool-workers": "^0.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vite-ssr-components": "^0.6.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.104.0"
  }
}
