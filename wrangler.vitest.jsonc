{
  // Vitest 専用の wrangler 設定。本番用 wrangler.jsonc から「AI バインディングだけ」を除いたもの。
  //
  // 理由: Workers AI バインディングは miniflare にローカル模擬が無く、テストのプール起動時に
  // 常にリモート接続を張る（テスト自体は AI を deps でモックしていて未使用にもかかわらず）。
  // これによりテストが遅く・ネットワーク/認証依存になり、実行後にプロセスが終了しない
  // （close timed out）問題が起きる。テストでは AI を外すことでこれを回避する。
  //
  // KV / D1 / Durable Objects は miniflare がローカル模擬するためリモート接続は張らない。
  // wrangler.jsonc に AI 以外のバインディングを足したら、テストで必要な分はこちらにも反映すること。
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "findy-hackathon-app",
  "main": "src/index.tsx",
  "compatibility_date": "2026-06-14",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ],
  // D1 / Durable Objects は miniflare がローカル模擬するためリモート接続を張らない。
  // 本番 wrangler.jsonc と同じバインディング名で揃える（AI だけは除外を維持）。
  // テストの D1 スキーマは setupFiles（test/apply-d1-migrations.ts）が
  // migrations/ を applyD1Migrations で適用する。
  "durable_objects": {
    "bindings": [{ "name": "RideSession", "class_name": "RideSession" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RideSession"] }],
  "d1_databases": [
    {
      "binding": "BURABURIDER_DB",
      "database_name": "buraburider",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "vars": {
    "MAPBOX_PUBLIC_TOKEN": "REPLACE_WITH_MAPBOX_PUBLIC_TOKEN"
  }
}
